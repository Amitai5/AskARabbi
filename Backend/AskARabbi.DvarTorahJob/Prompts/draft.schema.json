{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string" },
    "body": { "type": "string" },
    "centralTeaching": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "practicalActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "torahTeachings": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourcedStatement" }
    },
    "currentEventFacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourcedStatement" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourcedStatement" }
    }
  },
  "required": ["title", "body", "centralTeaching", "tags", "practicalActions", "torahTeachings", "currentEventFacts", "connections"],
  "$defs": {
    "sourcedStatement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["text", "evidenceIds"]
    }
  }
}

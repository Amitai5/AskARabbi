<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>AskARabbi.Api</AssemblyName>
    <RootNamespace>AskARabbi.Api</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <UserSecretsId>AskARabbi-Api-Development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WorkOS.net" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Library\AskARabbiLIB\AskARabbiLIB.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Prototype\Prompts\**\*" Link="Prompts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Data\NormalizedData\Sefaria\Metadata\document-manifest.json" Link="Data\document-manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "type": "string", "defaultValue": "centralus" },
    "environmentName": { "type": "string", "defaultValue": "askarabbi-containerapps-production" },
    "vnetName": { "type": "string", "defaultValue": "askarabbi-production-vnet" },
    "subnetName": { "type": "string", "defaultValue": "container-apps-production" },
    "logWorkspaceName": { "type": "string", "defaultValue": "askarabbi-loganalytics" }
  },
  "variables": {
    "subnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('subnetName'))]",
    "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logWorkspaceName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks/subnets",
      "apiVersion": "2024-05-01",
      "name": "[concat(parameters('vnetName'), '/', parameters('subnetName'))]",
      "properties": {
        "addressPrefix": "10.82.4.0/23",
        "delegations": [{ "name": "container-apps", "properties": { "serviceName": "Microsoft.App/environments" } }],
        "serviceEndpoints": [
          { "service": "Microsoft.AzureCosmosDB" },
          { "service": "Microsoft.CognitiveServices" }
        ]
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2025-02-02-preview",
      "name": "[parameters('environmentName')]",
      "location": "[parameters('location')]",
      "tags": { "application": "AskARabbi", "purpose": "Consolidated production runtime" },
      "dependsOn": ["[variables('subnetId')]"],
      "properties": {
        "infrastructureResourceGroup": "[concat('ME-', parameters('environmentName'))]",
        "vnetConfiguration": { "infrastructureSubnetId": "[variables('subnetId')]", "internal": false },
        "workloadProfiles": [{ "name": "Consumption", "workloadProfileType": "Consumption" }],
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(variables('workspaceId'), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(variables('workspaceId'), '2023-09-01').primarySharedKey]"
          }
        }
      }
    }
  ],
  "outputs": {
    "environmentId": { "type": "string", "value": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]" },
    "subnetId": { "type": "string", "value": "[variables('subnetId')]" }
  }
}

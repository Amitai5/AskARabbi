        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "description": "One independently verifiable factual or interpretive proposition; split compound propositions into separate claims." },
          "evidenceIds": { "type": "array", "description": "Existing packet evidence IDs that together directly support the complete proposition.", "items": { "type": "string" } },
          "attribution": { "type": ["string", "null"] },
          "quotations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evidenceId": { "type": "string" },
                "text": { "type": "string" },
                "role": { "type": "string", "description": "The exact part of this claim that the quotation supports." }
              },
              "required": ["evidenceId", "text", "role"]
            }
          }
        },
        "required": ["text", "evidenceIds", "attribution", "quotations"]
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "description": "One independently verifiable competing factual or interpretive proposition." },
          "evidenceIds": { "type": "array", "description": "Existing packet evidence IDs that together directly support the complete proposition.", "items": { "type": "string" } },
          "attribution": { "type": ["string", "null"] },
          "quotations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evidenceId": { "type": "string" },
                "text": { "type": "string" },
                "role": { "type": "string", "description": "The exact part of this disagreement that the quotation supports." }
              },
              "required": ["evidenceId", "text", "role"]
            }
          }
        },
        "required": ["text", "evidenceIds", "attribution", "quotations"]
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "clarifyingQuestion": { "type": ["string", "null"] },
    "humanGuidanceRecommended": { "type": "boolean" }
  },
  "required": ["conversationTitle", "claims", "disagreements", "limitations", "clarifyingQuestion", "humanGuidanceRecommended"]
